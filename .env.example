DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave POSTGRES_DB unset to use SQLite for quick local development.
POSTGRES_DB=tardytrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Safe defaults: the console provider performs no external send and attendance alerts are opt-in.
SMS_PROVIDER_CLASS=notifications.providers.ConsoleSMSProvider
SMS_MAX_RETRIES=3
SMS_AUTO_ATTENDANCE_NOTIFICATIONS=False
